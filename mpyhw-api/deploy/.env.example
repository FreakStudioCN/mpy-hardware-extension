# deploy/.env.example  -  copy to deploy/.env and fill in. NEVER commit the real deploy/.env.
# The API refuses to start in prod (MPYHW_ENV=prod) without the REQUIRED values below.

# -----------------------------------------------------------------------------
# REQUIRED  -  app exits at startup (validate_config) without all of these.
# -----------------------------------------------------------------------------

# Postgres. For the bundled `db` service in compose.yml, keep host `db` and make the
# password match POSTGRES_PASSWORD below. For a managed DB, point this at it.
DATABASE_URL=postgresql://mpyhw:CHANGE-ME-DB-PASSWORD@db:5432/mpyhw

# Must NOT be the dev default. Generate:  openssl rand -hex 32
MPYHW_JWT_SECRET=CHANGE-ME-random-64-hex

# DeepSeek LLM key  -  the old key is dead; get a FRESH one from the DeepSeek console.
DEEPSEEK_API_KEY=CHANGE-ME

# Admin token for /v1/admin.  Generate:  openssl rand -hex 24
MPYHW_ADMIN_TOKEN=CHANGE-ME-random

# -----------------------------------------------------------------------------
# REQUIRED for the extension's "Sign in with GitHub" (login errors without them).
# -----------------------------------------------------------------------------

MPYHW_GITHUB_CLIENT_ID=CHANGE-ME
MPYHW_GITHUB_CLIENT_SECRET=CHANGE-ME

# Public HTTPS URL of THIS backend. The GitHub OAuth callback is built from it as
#   <MPYHW_PUBLIC_API_BASE>/v1/auth/github/callback
# so this MUST be the new host, AND that exact callback must be registered in the
# GitHub OAuth app settings (github.com -> Settings -> Developer settings -> OAuth Apps):
#   https://api.block-less.com/v1/auth/github/callback
MPYHW_PUBLIC_API_BASE=https://api.block-less.com

# Bundled Postgres password (must match the one embedded in DATABASE_URL above).
POSTGRES_PASSWORD=CHANGE-ME-DB-PASSWORD

# -----------------------------------------------------------------------------
# OPTIONAL  -  sensible defaults exist.
# -----------------------------------------------------------------------------
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MPYHW_BROWSER_AUTH_REDIRECT_ORIGINS=   # allowed login-redirect origins; set only if the
#                                        # extension's redirect origin differs from the default
# SENTRY_DSN=
