# Add this block to your existing Caddyfile. Caddy auto-provisions TLS (Let's Encrypt) for a
# real, publicly-resolvable hostname  -  no cert work on our side.
#
# Prerequisite: the `api` container and Caddy share a Docker network (the `edge` / caddy_net
# network in deploy/compose.yml), so Caddy can reach the service by name `api`.

api.block-less.com {             # <-- the hostname the plugin backend is served at (a domain you control DNS for)
    reverse_proxy api:8080
}

# -----------------------------------------------------------------------------
# Alternative: if Caddy runs on the HOST (not in Docker), it can't resolve `api` by name.
# Then in compose.yml replace `expose: ["8080"]` with `ports: ["127.0.0.1:8080:8080"]`
# (loopback only  -  still no public :80/:443 grab) and use:
#
# api.block-less.com {
#     reverse_proxy 127.0.0.1:8080
# }
