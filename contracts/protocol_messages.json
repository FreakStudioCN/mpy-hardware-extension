{
  "protocol_version": "1.0.0",
  "source": "upy-project-gen-toolchain-spec/plugin-interface/02-protocol.md",
  "envelope": {
    "type": "object",
    "properties": {
      "msg_id": { "type": "string", "description": "Unique message id, correlates request/response." },
      "session_id": { "type": "string", "description": "Project session id, generated by the plugin on first send." },
      "phase": { "type": "string", "description": "Current pipeline phase (analyze/select-hw/scaffold/generate/simulate/deploy/autofix/wiring/diagram/cold-driver/publish)." },
      "timestamp": { "type": "string", "description": "ISO 8601 timestamp." },
      "type": { "type": "string", "description": "Message type; payload shape is determined by this." },
      "payload": { "type": "object" }
    },
    "required": ["session_id", "type", "payload"],
    "additionalProperties": true
  },
  "messages": {
    "approval_request": {
      "direction": "server->plugin",
      "description": "Ask the user to confirm/choose via a rich card. Replaces AskUserQuestion. Use for component confirmation, alternative selection, mode selection, debug guidance, and any clarification.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "approval_id": { "type": "string" },
          "header": { "type": "string" },
          "question": { "type": "string" },
          "summary": {
            "type": "object",
            "properties": {
              "project_name": { "type": "string" },
              "board": { "type": "object" },
              "description": { "type": "string" }
            },
            "additionalProperties": true
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "subtitle": { "type": "string" },
                "meta": { "type": "string" },
                "selectable": { "type": "boolean" },
                "selected": { "type": "boolean" }
              },
              "required": ["id", "name"],
              "additionalProperties": true
            }
          },
          "item_groups": {
            "type": ["array", "object"],
            "description": "Spec shape (02-protocol.md) is an array of {group_id, group_header, multi_select, items}; some plugin samples (scaffold_config, generate_behavior) instead emit an object map keyed by group_id ({label, multi_select, ...}). Upstream is inconsistent here — the renderer normalizes both shapes."
          },
          "allow_add": { "type": "boolean" },
          "allow_remove": { "type": "boolean" },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" },
                "primary": { "type": "boolean" }
              },
              "required": ["label", "value"],
              "additionalProperties": true
            }
          },
          "multi_select": { "type": "boolean" },
          "file_upload": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "accept": { "type": "array", "items": { "type": "string" } },
              "max_files": { "type": "integer" },
              "max_size_mb": { "type": "integer" },
              "generate_thumbnails": { "type": "boolean" },
              "thumbnail_size": { "type": "array", "items": { "type": "integer" } },
              "preprocess": { "type": "object" }
            },
            "additionalProperties": true
          },
          "text_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "placeholder": { "type": "string" },
                "type": { "type": "string", "enum": ["text", "url", "number"] }
              },
              "required": ["id"],
              "additionalProperties": true
            }
          },
          "guidance": {
            "type": "object",
            "properties": {
              "tool": { "type": "string" },
              "steps": { "type": "array", "items": { "type": "string" } },
              "normal_range": { "type": "string" },
              "diagram_ref": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "required": ["approval_id", "question"],
        "additionalProperties": true
      }
    },
    "status_update": {
      "direction": "server->plugin",
      "description": "Fire-and-forget progress narration rendered as a timeline entry. Plugin auto-acknowledges; never blocks.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "level": { "type": "string", "enum": ["info", "warn", "error", "success"] },
          "message": { "type": "string" },
          "progress": { "type": "number", "minimum": 0, "maximum": 1 },
          "progress_label": { "type": "string" },
          "step_id": { "type": "string" },
          "step_status": { "type": "string", "enum": ["pending", "running", "done", "failed"] },
          "detail": { "type": "string" }
        },
        "required": ["level", "message"],
        "additionalProperties": true
      }
    },
    "device_command": {
      "direction": "server->plugin",
      "description": "Pass an mpremote device operation to the plugin. Replaces scan_device/install_package/flash_and_run/read_serial_until/run_flash_device. code is required when action=exec; src+dst when action=cp; dst when action=cp_from/mkdir/ls/rm.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "cmd_id": { "type": "string" },
          "action": { "type": "string", "enum": ["devs", "scan", "exec", "cp", "cp_from", "mkdir", "ls", "rm", "soft_reset", "stream", "run"] },
          "code": { "type": "string" },
          "src": { "type": "string" },
          "dst": { "type": "string" },
          "timeout_ms": { "type": "number" },
          "expect_output": { "type": "boolean" }
        },
        "required": ["action"],
        "additionalProperties": true
      }
    },
    "file_operation": {
      "direction": "server->plugin",
      "description": "Read/write a workspace file. Replaces write_main_py/write_project_file/read_workspace_file. content is required when op=write/append (V0 is codegen-pure: the plugin writes file content inline; the server does NOT synthesize code).",
      "payload_schema": {
        "type": "object",
        "properties": {
          "op_id": { "type": "string" },
          "op": { "type": "string", "enum": ["write", "read", "list", "delete", "mkdir", "append"] },
          "path": { "type": "string" },
          "content": { "type": "string" },
          "encoding": { "type": "string" }
        },
        "required": ["op", "path"],
        "additionalProperties": true
      }
    },
    "script_run": {
      "direction": "server->plugin",
      "description": "Run a host script. Replaces run_validate/run_scaffold/run_static_check/run_simulate/run_triage/run_download_drivers/run_extract_pdf/render_wiring/render_diagram. cwd defaults to {project_dir}; {skill_dir} resolves to the skill scripts directory.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "script_id": { "type": "string" },
          "interpreter": { "type": "string", "enum": ["python", "node", "shell"] },
          "script": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string" },
          "timeout_ms": { "type": "number" }
        },
        "required": ["interpreter", "script"],
        "additionalProperties": true
      }
    },
    "phase_complete": {
      "direction": "server->plugin",
      "description": "Terminal message for a phase. next_phase (non-null) makes the plugin auto-issue the next start_phase with manifest from manifest_content. Fire-and-forget; plugin auto-acknowledges.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "enum": ["success", "failed", "partial"] },
          "summary": { "type": "string" },
          "next_phase": { "type": ["string", "null"] },
          "manifest_content": { "type": "object" },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "description": "Render hint. Base set is table/file_tree/markdown/html/code_diff/file_list; phases extend it (e.g. generate emits file_manifest, session_state). Unknown types render generically." },
                "title": { "type": "string" }
              },
              "required": ["type"],
              "additionalProperties": true
            }
          },
          "warnings": { "type": "array", "items": { "type": ["string", "object"] } },
          "errors": { "type": "array", "items": { "type": ["string", "object"] }, "description": "Plain strings, or structured {code, message, ...} objects (deploy/generate emit structured errors inline)." }
        },
        "required": ["result", "summary"],
        "additionalProperties": true
      }
    },
    "stream": {
      "direction": "server->plugin",
      "description": "Live data stream relay (device REPL output / script stdout). Not an LLM tool; emitted by the server during device_command(action=stream|read). Plugin replies with stream_ack.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "stream_id": { "type": "string" },
          "stream_type": { "type": "string", "enum": ["device_output", "script_stdout", "script_stderr"] },
          "chunk": { "type": "string" },
          "chunk_index": { "type": "number" },
          "done": { "type": "boolean" }
        },
        "required": ["stream_id", "stream_type", "chunk", "chunk_index", "done"],
        "additionalProperties": true
      }
    },
    "start_phase": {
      "direction": "plugin->server",
      "description": "First plugin->server message; triggers the server to load the phase SKILL.md and begin. manifest is carried from the upstream phase_complete.manifest_content; session_id continues an interrupted session.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "phase": { "type": "string" },
          "manifest": { "type": ["object", "null"] },
          "session_id": { "type": "string" },
          "source": { "type": ["object", "string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "approval_response": {
      "direction": "plugin->server",
      "description": "User's response to an approval_request.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "approval_id": { "type": "string" },
          "action": { "type": "string" },
          "selected_ids": { "type": "array", "items": { "type": "string" } },
          "added_items": { "type": "array" },
          "text_values": { "type": "object" },
          "uploaded_files": { "type": "array" },
          "notes": { "type": "string" }
        },
        "required": ["approval_id", "action"],
        "additionalProperties": true
      }
    },
    "device_result": {
      "direction": "plugin->server",
      "description": "Result of a device_command.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "cmd_id": { "type": "string" },
          "success": { "type": "boolean" },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "exit_code": { "type": "number" },
          "error_kind": { "type": "string" }
        },
        "required": ["cmd_id", "success"],
        "additionalProperties": true
      }
    },
    "script_result": {
      "direction": "plugin->server",
      "description": "Result of a script_run.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "script_id": { "type": "string" },
          "success": { "type": "boolean" },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "exit_code": { "type": "number" }
        },
        "required": ["script_id", "success"],
        "additionalProperties": true
      }
    },
    "file_result": {
      "direction": "plugin->server",
      "description": "Result of a file_operation.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "op_id": { "type": "string" },
          "success": { "type": "boolean" },
          "error": { "type": ["string", "null"] },
          "content": { "type": "string" },
          "entries": { "type": "array" }
        },
        "required": ["op_id", "success"],
        "additionalProperties": true
      }
    },
    "user_intervention": {
      "direction": "plugin->server",
      "description": "User interrupts a troubleshooting step (autofix only).",
      "payload_schema": {
        "type": "object",
        "properties": {
          "approval_id": { "type": "string" },
          "action": { "type": "string", "enum": ["pause", "skip", "abort", "resume"] },
          "notes": { "type": "string" }
        },
        "required": ["approval_id", "action"],
        "additionalProperties": true
      }
    },
    "error_lib_update": {
      "direction": "plugin->server",
      "description": "CRUD on the error library (autofix only).",
      "payload_schema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["add", "update", "delete", "query"] },
          "entry": {
            "type": "object",
            "properties": {
              "error_signature": { "type": "string" },
              "primary_error": { "type": "string" },
              "device_type": { "type": "string" },
              "root_cause": { "type": "string" },
              "fix_strategy": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "required": ["action"],
        "additionalProperties": true
      }
    },
    "stream_ack": {
      "direction": "plugin->server",
      "description": "Confirm/terminate a stream. The plugin sends stop with reason=marker_detected when it sees an expected marker, packaging captured output as a device_result.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "stream_id": { "type": "string" },
          "action": { "type": "string", "enum": ["continue", "stop"] },
          "chunk_index": { "type": "number" },
          "reason": { "type": "string", "enum": ["marker_detected", "timeout", "user_request"] }
        },
        "required": ["stream_id", "action"],
        "additionalProperties": true
      }
    }
  },
  "llm_tools": [
    "approval_request",
    "device_command",
    "file_operation",
    "script_run",
    "status_update",
    "phase_complete"
  ],
  "llm_tool_kinds": {
    "approval_request": "blocking",
    "device_command": "blocking",
    "file_operation": "blocking",
    "script_run": "blocking",
    "status_update": "notify",
    "phase_complete": "notify"
  }
}
