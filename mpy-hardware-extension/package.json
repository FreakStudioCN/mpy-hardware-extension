{
  "name": "mpy-hardware-extension",
  "version": "0.4.1",
  "publisher": "blockless",
  "displayName": "Blockless",
  "description": "Turn a sentence into a wired, deployable MicroPython hardware project.",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "media/icon.png",
  "type": "module",
  "categories": [
    "AI",
    "Education",
    "Other"
  ],
  "keywords": [
    "MicroPython",
    "hardware",
    "embedded",
    "IoT",
    "ESP32"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FreakStudioCN/mpy-hardware-extension.git"
  },
  "homepage": "https://github.com/FreakStudioCN/mpy-hardware-extension#readme",
  "bugs": {
    "url": "https://github.com/FreakStudioCN/mpy-hardware-extension/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension/activate.cjs",
  "activationEvents": [
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mpyhw",
          "title": "Blockless",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mpyhw": [
        {
          "id": "mpyhw.panel",
          "name": "Blockless",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "mpyhw.openPanel",
        "title": "Blockless: Open Panel"
      }
    ],
    "configuration": {
      "title": "Blockless",
      "properties": {
        "mpyhw.apiBaseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Override the Blockless backend API URL. Machine-scoped: settable only in User/Remote settings (not per-workspace), so an opened repository cannot redirect where auth tokens and generated code are sent. For local development, set this in User settings or use the MPYHW_API_BASE environment variable. Leave blank to use the default hosted backend."
        },
        "mpyhw.pythonPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Developer fallback runner Python path. Machine-scoped (User/Remote settings only) so a workspace cannot point it at an arbitrary executable. Leave blank for the default local runner behavior."
        },
        "mpyhw.pipIndexUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Developer fallback runner package index override. Machine-scoped (User/Remote settings only) so a workspace cannot redirect package installs to an untrusted index. Leave blank for default local runner behavior."
        }
      }
    }
  },
  "scripts": {
    "test": "node --no-warnings --experimental-strip-types --test test/*.test.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "baseline": "node scripts/baseline.mjs",
    "e2e:v0": "node --no-warnings --experimental-strip-types src/cli/e2e-protocol-v0.ts",
    "build": "node scripts/build-extension.mjs",
    "vscode:prepublish": "node scripts/prepare-vsce.mjs",
    "package": "node -e \"require('fs').mkdirSync('build',{recursive:true})\" && vsce package --out build/mpy-hardware-extension.vsix",
    "publish": "vsce publish",
    "smoke:extension": "npm test && npm run typecheck && npm run package",
    "test:v0": "node --no-warnings --experimental-strip-types --test test/protocol-build.test.ts test/protocol-loop.test.ts test/protocol-registry.test.ts test/sse-contract.test.ts",
    "code-shape": "node scripts/assert-code-shape.mjs",
    "golden-matrix": "node scripts/golden-path-matrix.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3"
  }
}
